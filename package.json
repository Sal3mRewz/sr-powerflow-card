{
  "name": "sr-powerflow-card",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "A Home Assistant power flow card (fork of Power Flow Card Plus, registered as sr-powerflow-card)",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "dashboard",
    "custom-cards"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sal3mRewz/sr-powerflow-card.git"
  },
  "author": "Sal3mRewz",
  "license": "MIT",
  "homepage": "https://github.com/Sal3mRewz/sr-powerflow-card#readme",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "custom-card-helpers": "1.9.0",
    "home-assistant-js-websocket": "8.2.0",
    "lit": "3.3.2",
    "lit-element": "2.5.1",
    "memoize-one": "6.0.0",
    "sortablejs": "1.15.7",
    "superstruct": "1.0.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@rollup/plugin-babel": "7.0.0",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "22.19.17",
    "@types/sortablejs": "1.15.9",
    "jsdom": "24.1.3",
    "rollup": "4.60.1",
    "rollup-plugin-minify-html-literals": "1.2.6",
    "rollup-plugin-serve": "1.1.1",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.4"
  },
  "overrides": {
    "rollup-plugin-minify-html-literals": {
      "rollup": "$rollup"
    }
  }
}
